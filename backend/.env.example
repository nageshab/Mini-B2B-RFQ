# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Supabase PostgreSQL connection string.
# Find this in: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Add ?pgbouncer=true&connection_limit=1 if using the pooled (PgBouncer) connection.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT — use a long random string in production (minimum 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# Server
PORT=3000

# Frontend origin for CORS (no trailing slash).
# Development: http://localhost:5173 (Vite default)
# Production: your Vercel deployment URL
FRONTEND_URL=http://localhost:5173

# Application environment: development | production | test
NODE_ENV=development
